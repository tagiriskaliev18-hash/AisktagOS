# AIsktagOS — параметры сборки.
# Всё, что касается имени и версии системы, меняется только здесь.

OS_NAME="AIsktagOS"
OS_ID="aisktagos"
OS_VERSION="1.1"
OS_CODENAME="Hybrid"
OS_TAGLINE="Операционная система для разработчиков со встроенным ИИ"
OS_URL="https://github.com/tagiriskaliev18-hash/AisktagOS"

# База: Ubuntu 24.04 LTS (Noble Numbat — стабильная LTS-основа)
UBUNTU_SUITE="noble"
UBUNTU_VERSION="24.04"   # номер выпуска для lsb-release (PPA и драйверы проверяют его)
UBUNTU_MIRROR="http://archive.ubuntu.com/ubuntu"
ARCH="amd64"

# Пользователь live-сессии (без пароля, только для USB/DVD)
LIVE_USER="aisktag"
LIVE_HOSTNAME="aisktagos"

# Язык live-системы по умолчанию (в установщике можно выбрать любой)
DEFAULT_LOCALE="ru_RU.UTF-8"
DEFAULT_KEYBOARD="us,ru"
DEFAULT_TIMEZONE="Asia/Almaty"

# Сжатие squashfs: xz — меньше ISO, zstd — быстрее сборка
SQUASHFS_COMP="${SQUASHFS_COMP:-xz}"

# --- Встроенный ИИ Mind -----------------------------------------------------------
# Движок: готовые сборки llama.cpp (MIT). Закреплена конкретная сборка и её SHA-256.
# CPU — работает везде; Vulkan — на настоящих видеокартах AMD/Intel/NVIDIA (драйвер Mesa/NVIDIA).
LLAMACPP_BUILD="b11408"
LLAMACPP_CPU_SHA256="55e75926a30d0ca10f8ae006611a0c78a3f4056f5a87f24adde9d35d6584ba26"
LLAMACPP_VULKAN_SHA256="ac04cd30dc00bdbe28e27ed96e730038c5b843f0e0569ccb29b7ee8ef20e67de"
# Какая модель из overlay/usr/share/aisktagos/ai/models.json вшивается в образ: lite (1,1 ГБ), standard, pro или none.
# Для быстрой тестовой сборки: AI_BUNDLE_MODEL=none sudo ./build.sh all
AI_BUNDLE_MODEL="${AI_BUNDLE_MODEL:-lite}"

# lazygit (в Ubuntu 24.04 нет пакета): терминальный интерфейс для Git, закреплённая версия и SHA-256
LAZYGIT_VERSION="0.65.1"
LAZYGIT_SHA256="02beacbcda0fa342e50ae3480ba8147307353af3fb28e1d5f790e02329c201a6"
