---
componentName: aisktagos

# Окно-мастер по центру экрана, как установщик Windows
windowExpanding: normal
windowSize: 1024px,680px
windowPlacement: center
sidebar: widget
navigation: widget

strings:
    productName:         AIsktagOS
    shortProductName:    AIsktagOS
    version:             1.0 Genesis
    shortVersion:        "1.0"
    versionedName:       AIsktagOS 1.0
    shortVersionedName:  AIsktagOS 1.0
    bootloaderEntryName: AIsktagOS
    productUrl:          https://github.com/tagiriskaliev18-hash/aisktagos
    supportUrl:          https://github.com/tagiriskaliev18-hash/aisktagos/issues
    knownIssuesUrl:      https://github.com/tagiriskaliev18-hash/aisktagos/issues
    releaseNotesUrl:     https://github.com/tagiriskaliev18-hash/aisktagos/releases

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            1

# Цвета списка шагов слева (Calamares рисует его сам, QSS на него не действует).
# Остальное оформление — в stylesheet.qss рядом.
style:
   SidebarBackground:        "#111a33"
   SidebarText:              "#8f9abf"
   SidebarTextCurrent:       "#ffffff"
   SidebarBackgroundCurrent: "#2a5be0"
