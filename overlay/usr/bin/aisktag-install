#!/usr/bin/env bash
# Запуск установщика AIsktagOS (Calamares) с правами администратора.
# В live-сессии sudo работает без пароля. sudo-rs (Ubuntu 26.04) не поддерживает «sudo -E»,
# поэтому переменные, нужные для доступа к экрану (Wayland или X11), передаются явно.
# Root и так может открыть сокет Wayland пользователя, а для X11 нужен xhost.
if pgrep -x calamares >/dev/null; then
    exit 0
fi

if [ -n "${DISPLAY:-}" ] && command -v xhost >/dev/null; then
    xhost +SI:localuser:root >/dev/null 2>&1 || true
fi

# -d: в окне установщика появляется кнопка «Показать отладочную информацию» —
# живой журнал всех шагов установки, чтобы было видно, что происходит прямо сейчас.
# Полный журнал также пишется в /root/.cache/calamares/session.log.
sudo env \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
    DISPLAY="${DISPLAY:-}" \
    XAUTHORITY="${XAUTHORITY:-}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-}" \
    XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-KDE}" \
    KDE_FULL_SESSION=true \
    ${QT_QUICK_BACKEND:+QT_QUICK_BACKEND="$QT_QUICK_BACKEND"} \
    QT_QPA_PLATFORMTHEME=kde \
    LANG="${LANG:-C.UTF-8}" \
    LANGUAGE="${LANGUAGE:-}" \
    HOME=/root XDG_CONFIG_HOME=/root/.config XDG_CACHE_HOME=/root/.cache \
    calamares -d "$@"
rc=$?

# Установщик не открылся или упал — не оставляем пользователя перед пустым экраном
if [ "$rc" -ne 0 ]; then
    msg="Установщик завершился с ошибкой (код $rc).
Журнал: /root/.cache/calamares/session.log
Запустите установку ещё раз значком «Установить AIsktagOS» на рабочем столе."
    if command -v kdialog >/dev/null; then
        kdialog --title "Установка AIsktagOS" --error "$msg"
    else
        echo "$msg" >&2
    fi
fi
exit "$rc"
