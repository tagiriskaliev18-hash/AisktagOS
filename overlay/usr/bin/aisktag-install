#!/usr/bin/env bash
# Запуск установщика AIsktagOS (Calamares) с правами администратора.
# В live-сессии sudo работает без пароля. Переменные, нужные для доступа к экрану (Wayland или X11),
# передаются явно: «sudo -E» не везде поддерживается (например, sudo-rs в Ubuntu 26.04).
if pgrep -x calamares >/dev/null; then
    exit 0
fi

# Доступ root к экрану: сокет Wayland (live-сессия одноразовая, права можно открыть) и X11
if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    sudo chmod 0777 "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" 2>/dev/null || true
fi
xhost +SI:localuser:root 2>/dev/null || true

exec sudo env \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
    DISPLAY="${DISPLAY:-}" \
    XAUTHORITY="${XAUTHORITY:-}" \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-}" \
    XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-KDE}" \
    KDE_FULL_SESSION=true \
    ${QT_QUICK_BACKEND:+QT_QUICK_BACKEND="$QT_QUICK_BACKEND"} \
    QT_QPA_PLATFORMTHEME=kde \
    LANG="${LANG:-C.UTF-8}" \
    LANGUAGE="${LANGUAGE:-}" \
    HOME=/root XDG_CONFIG_HOME=/root/.config XDG_CACHE_HOME=/root/.cache \
    calamares "$@"
