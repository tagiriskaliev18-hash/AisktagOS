[Unit]
Description=AIsktag Mind: прокси к локальной модели (выключается после простоя)
Requires=aisktag-llm.socket aisktag-llm-backend.service
After=aisktag-llm.socket aisktag-llm-backend.service

[Service]
# Через 15 минут без запросов прокси завершается, а следом останавливается сервер модели и освобождает память
ExecStart=/usr/lib/systemd/systemd-socket-proxyd --exit-idle-time=15min 127.0.0.1:6574
DynamicUser=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
