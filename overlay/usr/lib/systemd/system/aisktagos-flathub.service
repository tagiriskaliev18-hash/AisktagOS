[Unit]
Description=AIsktagOS: подключение магазина приложений Flathub
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/flatpak/repo/flathub.trustedkeys.gpg
# В live-сессии (USB/DVD) ничего не скачиваем — только в установленной системе
ConditionKernelCommandLine=!boot=casper

[Service]
Type=oneshot
ExecStart=/usr/bin/flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo
Restart=on-failure
RestartSec=10min

[Install]
WantedBy=multi-user.target
